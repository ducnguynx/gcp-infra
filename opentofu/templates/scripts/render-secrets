#!/usr/bin/env bash

set -Eeuo pipefail
umask 077

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

readonly APPLICATION_UID=2000
readonly SECRET_DIRECTORY=/run/homelab
readonly METADATA_URL=http://metadata.google.internal/computeMetadata/v1

TEMPORARY_FILES=()

fail() {
    echo "secret renderer: $*" >&2
    exit 1
}

cleanup() {
    local temporary_file

    for temporary_file in "${TEMPORARY_FILES[@]}"; do
        if [[ -f "$temporary_file" ]]; then
            rm -f -- "$temporary_file"
        fi
    done
}

trap cleanup EXIT
trap 'fail "failed at line $LINENO"' ERR

if [[ "$(id -u)" -ne "$APPLICATION_UID" ]]; then
    fail "must run as UID $APPLICATION_UID"
fi

if [[ -L "$SECRET_DIRECTORY" ]]; then
    fail "$SECRET_DIRECTORY must not be a symbolic link"
fi

if [[ ! -d "$SECRET_DIRECTORY" ]]; then
    fail "$SECRET_DIRECTORY does not exist"
fi

if [[ ! -O "$SECRET_DIRECTORY" || ! -w "$SECRET_DIRECTORY" ]]; then
    fail "$SECRET_DIRECTORY is not owned and writable by vps-app"
fi

DIRECTORY_MODE="$(stat -c '%a' "$SECRET_DIRECTORY")"

[[ "$DIRECTORY_MODE" == 700 ]] ||
    fail "$SECRET_DIRECTORY must have mode 0700"

PROJECT_ID="$(
    curl --fail --silent --show-error \
        --connect-timeout 3 \
        --max-time 10 \
        -H 'Metadata-Flavor: Google' \
        "$METADATA_URL/project/project-id"
)"

ACCESS_TOKEN="$(
    curl --fail --silent --show-error \
        --connect-timeout 3 \
        --max-time 10 \
        -H 'Metadata-Flavor: Google' \
        "$METADATA_URL/instance/service-accounts/default/token" |
        jq -er '.access_token'
)"

fetch_secret() {
    local secret_name="$1"
    local output_variable="$2"
    local temporary_file

    temporary_file="$(
        mktemp "$SECRET_DIRECTORY/.${secret_name}.XXXXXX"
    )"

    TEMPORARY_FILES+=("$temporary_file")

    curl --fail --silent --show-error \
        --connect-timeout 3 \
        --max-time 20 \
        -H "Authorization: Bearer $ACCESS_TOKEN" \
        "https://secretmanager.googleapis.com/v1/projects/$PROJECT_ID/secrets/$secret_name/versions/latest:access" |
        jq -er '.payload.data | select(type == "string")' |
        base64 --decode >"$temporary_file"

    [[ -s "$temporary_file" ]] ||
        fail "$secret_name returned an empty payload"

    printf -v "$output_variable" '%s' "$temporary_file"
}

fetch_secret spotify-oauth SPOTIFY_TEMPORARY
fetch_secret youtube-oauth YOUTUBE_TEMPORARY
fetch_secret grafana-admin-password GRAFANA_TEMPORARY

unset ACCESS_TOKEN

jq -e 'type == "object" and length > 0' \
    "$SPOTIFY_TEMPORARY" >/dev/null ||
    fail "spotify-oauth is not a nonempty JSON object"

jq -e 'type == "object" and length > 0' \
    "$YOUTUBE_TEMPORARY" >/dev/null ||
    fail "youtube-oauth is not a nonempty JSON object"

chmod 0444 \
    "$SPOTIFY_TEMPORARY" \
    "$YOUTUBE_TEMPORARY" \
    "$GRAFANA_TEMPORARY"

mv -fT \
    "$SPOTIFY_TEMPORARY" \
    "$SECRET_DIRECTORY/spotify-oauth.json"

mv -fT \
    "$YOUTUBE_TEMPORARY" \
    "$SECRET_DIRECTORY/youtube-oauth.json"

mv -fT \
    "$GRAFANA_TEMPORARY" \
    "$SECRET_DIRECTORY/grafana-admin-password"

TEMPORARY_FILES=()

echo "secret renderer: runtime secrets rendered successfully"
