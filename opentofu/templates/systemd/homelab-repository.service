[Unit]
Description=Prepare the homelab GitOps repository
Wants=network-online.target
After=network-online.target
Requires=user-runtime-dir@2000.service
After=user-runtime-dir@2000.service

[Service]
Type=oneshot
User=vps-app
Group=vps-app
Environment=HOME=/home/vps-app
Environment=XDG_RUNTIME_DIR=/run/user/2000
ExecStart=/usr/local/libexec/homelab/repository-bootstrap
RemainAfterExit=yes
NoNewPrivileges=yes
UMask=0077
TimeoutStartSec=120
