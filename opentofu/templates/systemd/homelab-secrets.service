[Unit]
Description=Render homelab runtime secrets
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=vps-app
Group=vps-app
Environment=HOME=/home/vps-app
Environment=XDG_RUNTIME_DIR=/run/user/2000
RuntimeDirectory=homelab
RuntimeDirectoryMode=0700
ExecStart=/usr/local/libexec/homelab/render-secrets
RemainAfterExit=yes
NoNewPrivileges=yes
UMask=0077
TimeoutStartSec=120
